# .gitignore file

# Python environment
__pycache__/
__pypackages__/
*.py[cod]
*.pyo
*.pyd

# Python Virtual Environment
venv/
pyenv/
.python-version

# Poetry
__pypoetry__/
poetry.lock

# PostgreSQL
*.sql

# Environment variables (git has no inline comments: a "# ..." after the name made these patterns never match)
# Contains sensitive API keys and secrets
.env.secret
# Local development overrides, production and staging settings
.env.local
.env.production
.env.staging

# Generated audio (spoken briefings)
*.mp3

# Editor-specific files
.vscode/
.idea/

# Logs
*.log

# Compiled files
*.pyc

# Dependency directories
env/
lib/
libs/

# Other

# Tests
.venv/
.pytest_cache/
